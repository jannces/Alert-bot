//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// TAMAD STRATEGY SCANNER — MEXC USDT Perpetual Futures
//
// Detects the strict three-candle Tamad rejection pattern at meaningful
// support/resistance and fires a JSON webhook alert AFTER candle 3 has fully
// closed. It also draws the complete trade picture on the chart (highlighted
// pattern candles, S/R line, entry, stop loss, TP2, TP3) so a screenshot of
// this chart contains every annotation required in the Telegram alert.
//
// This script only DETECTS and NOTIFIES. It never trades.
//
// Setup:
//   1. Add this indicator to a MEXC USDT-perp chart (e.g. MEXC:BTCUSDT.P)
//      on a 15m / 30m / 1h timeframe.
//   2. Set the "Webhook Secret" input to the same value as WEBHOOK_SECRET
//      on the scanner host.
//   3. Create an alert: Condition = this indicator → "Any alert() function
//      call", Options = "Once per bar close", Webhook URL =
//      https://<your-host>/webhook/tradingview
//   4. Repeat per symbol/timeframe you want scanned (or apply the alert to
//      every symbol of a watchlist if your TradingView plan supports it).
//
// Inputs mirror config/config.yaml — keep both sides identical, the Python
// service re-validates every rule and rejects mismatches.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Tamad Strategy Scanner [MEXC Perp]", "TAMAD", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ── Inputs ───────────────────────────────────────────────────────────────────
tolerancePct   = input.float(0.05, "Equal Close Tolerance (%)", minval = 0.0, step = 0.01,
     tooltip = "Max difference between candle 1 and candle 2 closes, as % of candle 1 close.")
levelBasisOpt  = input.string("strict", "Level Basis", options = ["strict", "outer", "avg"],
     tooltip = "How the exact S/R level is derived from the two near-equal closes. strict = the close candle 3 is least allowed to break (reject when in doubt).")
swingLookback  = input.int(10, "Swing Lookback (bars each side)", minval = 2)
srProximityPct = input.float(0.15, "S/R Proximity (%)", minval = 0.01, step = 0.01,
     tooltip = "Pattern level must sit within this % of a meaningful S/R level, otherwise no alert (middle-of-range patterns are ignored).")
useSwings      = input.bool(true,  "Use Swing High/Low levels")
usePrevDay     = input.bool(true,  "Use Previous Day High/Low")
usePrevWeek    = input.bool(true,  "Use Previous Week High/Low")
webhookSecret  = input.string("", "Webhook Secret",
     tooltip = "Must match WEBHOOK_SECRET on the scanner host.")

colShort  = color.new(color.red, 0)
colLong   = color.new(color.teal, 0)
colHilite = color.new(color.orange, 78)

// ── Pattern primitives ───────────────────────────────────────────────────────
isGreen(int i) => close[i] > open[i]
isRed(int i)   => close[i] < open[i]

// Tolerance measured relative to candle 1's close (matches the Python side).
equalClose() => math.abs(close[2] - close[1]) <= close[2] * tolerancePct / 100.0

// Level implied by the two (near-)equal closes.
patternLevel(bool isShort) =>
    c1 = close[2]
    c2 = close[1]
    levelBasisOpt == "avg" ? (c1 + c2) / 2.0 :
         isShort ?
             (levelBasisOpt == "strict" ? math.min(c1, c2) : math.max(c1, c2)) :
             (levelBasisOpt == "strict" ? math.max(c1, c2) : math.min(c1, c2))

// ── Support / Resistance context ────────────────────────────────────────────
// Confirmed swing points (kept in rolling arrays)…
var array<float> swingHighs = array.new<float>()
var array<float> swingLows  = array.new<float>()
MAX_LEVELS = 50

ph = ta.pivothigh(high, swingLookback, swingLookback)
if not na(ph)
    array.push(swingHighs, ph)
    if array.size(swingHighs) > MAX_LEVELS
        array.shift(swingHighs)
pl = ta.pivotlow(low, swingLookback, swingLookback)
if not na(pl)
    array.push(swingLows, pl)
    if array.size(swingLows) > MAX_LEVELS
        array.shift(swingLows)

// …plus previous-day and previous-week extremes (closed periods only).
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]],
     lookahead = barmerge.lookahead_on)

near(float lvl, float ref) =>
    not na(lvl) and math.abs(lvl - ref) <= ref * srProximityPct / 100.0

nearestFromArray(array<float> levels, float ref) =>
    float best = na
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lvl = array.get(levels, i)
            if near(lvl, ref) and (na(best) or math.abs(lvl - ref) < math.abs(best - ref))
                best := lvl
    best

// Returns [srType, srLevel]; srType is na when the pattern is NOT at
// meaningful S/R (→ no alert: middle-of-range patterns are rejected).
findSR(bool isShort, float ref) =>
    string srType = na
    float srLevel = na
    if isShort
        swing = useSwings ? nearestFromArray(swingHighs, ref) : na
        if not na(swing)
            srType  := "swing_high"
            srLevel := swing
        else if usePrevDay and near(pdh, ref)
            srType  := "prev_day_high"
            srLevel := pdh
        else if usePrevWeek and near(pwh, ref)
            srType  := "prev_week_high"
            srLevel := pwh
    else
        swing = useSwings ? nearestFromArray(swingLows, ref) : na
        if not na(swing)
            srType  := "swing_low"
            srLevel := swing
        else if usePrevDay and near(pdl, ref)
            srType  := "prev_day_low"
            srLevel := pdl
        else if usePrevWeek and near(pwl, ref)
            srType  := "prev_week_low"
            srLevel := pwl
    [srType, srLevel]

// ── Pattern detection (current bar = candle 3) ───────────────────────────────
// SHORT: green / red (equal closes = resistance) / green closing ≤ resistance.
// LONG : red / green (equal closes = support)    / red   closing ≥ support.
shortColors = isGreen(2) and isRed(1) and isGreen(0)
longColors  = isRed(2)   and isGreen(1) and isRed(0)

resistance = patternLevel(true)
support    = patternLevel(false)

shortPattern = shortColors and equalClose() and close <= resistance
longPattern  = longColors  and equalClose() and close >= support

// ── Drawing ──────────────────────────────────────────────────────────────────
drawSetup(bool isShort, float lvl, float srLevel, float entry, float sl, float tp2, float tp3) =>
    dirColor = isShort ? colShort : colLong
    top = math.max(high, math.max(high[1], high[2]))
    bot = math.min(low,  math.min(low[1],  low[2]))
    // Highlight the three strategy candles.
    box.new(bar_index - 2, top, bar_index, bot, xloc = xloc.bar_index,
         border_color = color.orange, border_width = 2, bgcolor = colHilite)
    // Support/resistance level.
    line.new(bar_index - 12, srLevel, bar_index + 15, srLevel, xloc = xloc.bar_index,
         color = color.orange, width = 2, style = line.style_solid)
    label.new(bar_index + 15, srLevel, (isShort ? "RESISTANCE " : "SUPPORT ") + str.tostring(srLevel),
         style = label.style_label_left, color = color.orange, textcolor = color.white, size = size.small)
    // Entry / stop / targets.
    line.new(bar_index, entry, bar_index + 15, entry, xloc = xloc.bar_index,
         color = color.blue, width = 2)
    label.new(bar_index + 15, entry, "ENTRY " + str.tostring(entry),
         style = label.style_label_left, color = color.blue, textcolor = color.white, size = size.small)
    line.new(bar_index, sl, bar_index + 15, sl, xloc = xloc.bar_index,
         color = color.red, width = 2, style = line.style_dashed)
    label.new(bar_index + 15, sl, "SL " + str.tostring(sl),
         style = label.style_label_left, color = color.red, textcolor = color.white, size = size.small)
    line.new(bar_index, tp2, bar_index + 15, tp2, xloc = xloc.bar_index,
         color = color.green, width = 2, style = line.style_dashed)
    label.new(bar_index + 15, tp2, "TP2 " + str.tostring(tp2),
         style = label.style_label_left, color = color.green, textcolor = color.white, size = size.small)
    line.new(bar_index, tp3, bar_index + 15, tp3, xloc = xloc.bar_index,
         color = color.green, width = 2, style = line.style_dotted)
    label.new(bar_index + 15, tp3, "TP3 " + str.tostring(tp3),
         style = label.style_label_left, color = color.green, textcolor = color.white, size = size.small)
    label.new(bar_index - 1, isShort ? top : bot, isShort ? "TAMAD SHORT" : "TAMAD LONG",
         style = isShort ? label.style_label_down : label.style_label_up,
         color = dirColor, textcolor = color.white, size = size.normal)

// ── Alert payload ─────────────────────────────────────────────────────────────
num(float x) => str.tostring(x, "#.##########")

candleJson(int i) =>
    '{"t":' + str.tostring(time[i]) + ',"o":' + num(open[i]) + ',"h":' + num(high[i]) +
         ',"l":' + num(low[i]) + ',"c":' + num(close[i]) + '}'

alertJson(string direction, float lvl, string srType, float srLevel,
          float entry, float sl, float tp2, float tp3) =>
    '{"secret":"' + webhookSecret + '"' +
     ',"strategy":"TAMAD","version":1' +
     ',"exchange":"' + syminfo.prefix + '"' +
     ',"symbol":"' + syminfo.ticker + '"' +
     ',"timeframe":"' + timeframe.period + '"' +
     ',"direction":"' + direction + '"' +
     ',"level":' + num(lvl) +
     ',"sr_type":"' + srType + '"' +
     ',"sr_level":' + num(srLevel) +
     ',"candles":[' + candleJson(2) + ',' + candleJson(1) + ',' + candleJson(0) + ']' +
     ',"entry":' + num(entry) +
     ',"sl":' + num(sl) +
     ',"tp2":' + num(tp2) +
     ',"tp3":' + num(tp3) +
     ',"detected_at_ms":' + str.tostring(timenow) + '}'

// ── Signal emission — only on fully closed candle 3 ──────────────────────────
if barstate.isconfirmed and shortPattern
    [srType, srLevel] = findSR(true, resistance)
    if not na(srType)
        entry = close
        sl    = math.max(high, math.max(high[1], high[2]))
        risk  = sl - entry
        if risk > 0
            tp2 = entry - 2.0 * risk
            tp3 = entry - 3.0 * risk
            drawSetup(true, resistance, srLevel, entry, sl, tp2, tp3)
            alert(alertJson("SHORT", resistance, srType, srLevel, entry, sl, tp2, tp3),
                 alert.freq_once_per_bar_close)

if barstate.isconfirmed and longPattern
    [srType, srLevel] = findSR(false, support)
    if not na(srType)
        entry = close
        sl    = math.min(low, math.min(low[1], low[2]))
        risk  = entry - sl
        if risk > 0
            tp2 = entry + 2.0 * risk
            tp3 = entry + 3.0 * risk
            drawSetup(false, support, srLevel, entry, sl, tp2, tp3)
            alert(alertJson("LONG", support, srType, srLevel, entry, sl, tp2, tp3),
                 alert.freq_once_per_bar_close)
