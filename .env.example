# Copy to .env and fill in. Load with: set -a; source .env; set +a

# Shared secret carried by every TradingView alert. Use a long random value,
# e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Telegram bot credentials (create the bot with @BotFather; get the chat id
# from @userinfobot or the getUpdates API).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed when screenshots.provider = chart_img
CHART_IMG_API_KEY=
